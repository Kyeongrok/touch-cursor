<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TouchCursor.Support.UI.Views">

    <Style TargetType="{x:Type local:ActivationOverlayWindow}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ActivationOverlayWindow}">
                    <Border Background="#E0333333" CornerRadius="8" Padding="6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="StatusIndicator" Width="22" Height="22" CornerRadius="11" Background="#4CAF50" BorderThickness="0" Margin="0,0,0,0">
                                <TextBlock x:Name="ImeText" Text="A"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" LineHeight="13" LineStackingStrategy="BlockLineHeight"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Waiting">
                            <Setter TargetName="StatusIndicator" Property="Background" Value="#4CAF50"/>
                        </Trigger>
                        <Trigger Property="State" Value="Activated">
                            <Setter TargetName="StatusIndicator" Property="Background" Value="#2196F3"/>
                        </Trigger>
                        <Trigger Property="IsCapsLockOn" Value="True">
                            <Setter TargetName="StatusIndicator" Property="CornerRadius" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsKoreanImeOn" Value="True">
                            <Setter TargetName="StatusIndicator" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="StatusIndicator" Property="BorderBrush" Value="#FFD700"/>
                            <!-- 한글 입력 상태: 한, 영문 입력 상태: A -->
                            <Setter TargetName="ImeText" Property="Text" Value="한"/>
                            <Setter TargetName="ImeText" Property="FontSize" Value="11"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
